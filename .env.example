# Copy to .env; keep this file out of version control.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Optional during OpenF1 live-session restrictions. Bearer token, never committed.
OPENF1_TOKEN=
GCS_BUCKET=f1-pitwall-2026-qh719-data
GOOGLE_CLOUD_PROJECT=f1-pitwall-2026-qh719
# For local GCS: gcloud auth application-default login
# MLflow defaults to a local SQLite store.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
CONFIG_PATH=config.yaml
